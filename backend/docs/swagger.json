{
    "swagger": "2.0",
    "info": {
        "description": "API for verifying digital diploma extracts from DUO (Dienst Uitvoering Onderwijs, \"Mijn diploma's\") and issuing them as privacy-preserving Yivi credentials.\nThe service verifies the PAdES signature DUO puts on every extract (certification signature, RFC 3161 timestamp, certificate chain to a qualified trust service on the EU Trusted Lists, DUO as signer), reads the printed data (qualification, holder, institution, date), lets the holder prove their identity with a BRP, passport, ID card or driving licence credential in the Yivi app, checks that this identity matches the holder named on the extracts and then issues one diploma credential per extract (IRMA and SD-JWT VC formats) over the IRMA protocol. Several extracts of the same holder can be uploaded and issued at once.",
        "title": "Go Diploma Issuer API",
        "contact": {
            "name": "Privacy by Design Foundation"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0"
        },
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/diploma/issue": {
            "post": {
                "description": "Fetches the result of the disclosure session, compares the disclosed name and date of birth with the holder named on the extracts and, when they match, returns a signed IRMA issuance request with one diploma credential per accepted extract (IRMA and SD-JWT VC formats, issued over the IRMA protocol in a single session). On a mismatch the disclosure is discarded and the user may disclose again with another credential; the uploaded extracts stay available until the session expires.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Diploma"
                ],
                "summary": "Verify identity and issue diploma credentials",
                "parameters": [
                    {
                        "description": "Session from /diploma/upload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SessionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.IssuanceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "the disclosed identity does not match the holder of the extracts, or the disclosure proof is invalid",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "unknown or expired session",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "the disclosure session has not finished (or was not started)",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "the IRMA server could not be reached",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/diploma/start-disclosure": {
            "post": {
                "description": "Starts a Yivi disclosure session in which the holder proves their identity with one of four credentials: BRP personal data (gemeente.personalData), passport, ID card or driving licence. The Yivi app lets the user pick. The response is the IRMA session package that yivi-frontend consumes directly (use it as the response of the `session.start` request with the default mapping and `result: false`). The requestor token is kept server side.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Diploma"
                ],
                "summary": "Start identity disclosure",
                "parameters": [
                    {
                        "description": "Session from /diploma/upload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.SessionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.DisclosureSessionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "unknown or expired session",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "the IRMA server did not accept the session",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/diploma/upload": {
            "post": {
                "description": "Accepts one or more diploma extract PDFs from DUO's \"Mijn diploma's\" (repeat the multipart form field \"file\", at most max_files per request). Every file is verified cryptographically: the PDF must carry a single certification signature that covers the whole file, the signature must be valid, timestamped by a qualified timestamp authority and made with a qualified electronic seal certificate of DUO that chains to a trust service on the EU Trusted Lists. Only then is the printed data read (qualification, holder, date of birth, institution, award date, level). All accepted extracts must name the same holder. Files that fail are reported per file; as long as one file is accepted the request succeeds and a session is created for the accepted files. The session expires after one hour.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Diploma"
                ],
                "summary": "Upload and verify diploma extracts",
                "parameters": [
                    {
                        "type": "file",
                        "description": "One or more diploma extract PDFs downloaded from Mijn diploma's (DUO)",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "at least one file was accepted; check files[].accepted for the rest",
                        "schema": {
                            "$ref": "#/definitions/models.UploadResponse"
                        }
                    },
                    "400": {
                        "description": "no file, too many files, or none of the files is a PDF / a diploma extract (per-file detail in files)",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "a file or the request exceeds the size limit",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "none of the files was accepted because the signature verification failed (per-file detail in files)",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "the trust anchors (EU trusted lists) are not available, so signatures cannot be verified right now",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Returns the health status of the API service",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.CheckInfo": {
            "type": "object",
            "properties": {
                "detail": {
                    "description": "Technical detail of the outcome",
                    "type": "string",
                    "example": "3 certificates, anchor \"Staat der Nederlanden Root CA - G3\""
                },
                "id": {
                    "description": "Stable identifier, e.g. certificate_chain",
                    "type": "string",
                    "example": "certificate_chain"
                },
                "name": {
                    "description": "Short English label",
                    "type": "string",
                    "example": "certificate chain to trust anchor"
                },
                "ok": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "models.DisclosureSessionResponse": {
            "type": "object",
            "properties": {
                "frontendRequest": {
                    "description": "Frontend session request (pairing options) as produced by the IRMA server",
                    "type": "object"
                },
                "sessionPtr": {
                    "$ref": "#/definitions/models.SessionPointer"
                }
            }
        },
        "models.DocumentInfo": {
            "type": "object",
            "properties": {
                "date_awarded": {
                    "description": "Date the diploma was awarded, YYYY-MM-DD",
                    "type": "string",
                    "example": "2009-07-01"
                },
                "date_of_birth": {
                    "description": "Date of birth, YYYY-MM-DD",
                    "type": "string",
                    "example": "1980-02-03"
                },
                "document_number": {
                    "description": "Number DUO prints in the footer of the extract",
                    "type": "string",
                    "example": "2896311"
                },
                "document_type": {
                    "description": "\"Diploma\" or \"Getuigschrift\"",
                    "type": "string",
                    "example": "Diploma"
                },
                "download_date": {
                    "description": "Day the extract was downloaded from DUO, YYYY-MM-DD",
                    "type": "string",
                    "example": "2026-09-03"
                },
                "eqf_level": {
                    "description": "EQF level, if printed",
                    "type": "string",
                    "example": "4"
                },
                "full_name": {
                    "description": "Holder as printed (given names and surname in one line)",
                    "type": "string",
                    "example": "Anna Maria van der Berg"
                },
                "has_grade_list": {
                    "description": "True when the extract includes the list of grades",
                    "type": "boolean",
                    "example": false
                },
                "institution": {
                    "description": "Institution that awarded the diploma",
                    "type": "string",
                    "example": "Hogeschool van Arnhem en Nijmegen"
                },
                "nlqf_level": {
                    "description": "NLQF level, if printed",
                    "type": "string",
                    "example": "4"
                },
                "pages": {
                    "type": "integer",
                    "example": 1
                },
                "place_of_issue": {
                    "type": "string",
                    "example": "Arnhem"
                },
                "profiles": {
                    "description": "Profiles, if printed",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Natuur en Techniek"
                    ]
                },
                "qualification": {
                    "description": "Name of the qualification",
                    "type": "string",
                    "example": "Hoger algemeen voortgezet onderwijs"
                }
            }
        },
        "models.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "description": "Stable machine readable error key, e.g. \"error:validation-failed\"",
                    "type": "string",
                    "example": "error:validation-failed"
                },
                "files": {
                    "description": "Per-file outcome when an upload was refused because no file was accepted",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.FileResult"
                    }
                },
                "identity": {
                    "description": "Identity comparison outcome when the error concerns the identity match",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.IdentityMatchInfo"
                        }
                    ]
                },
                "message": {
                    "description": "Human readable explanation (English)",
                    "type": "string",
                    "example": "none of the uploaded files was accepted"
                }
            }
        },
        "models.FileResult": {
            "type": "object",
            "properties": {
                "accepted": {
                    "description": "True when the file was accepted into the session",
                    "type": "boolean",
                    "example": true
                },
                "document": {
                    "description": "Parsed data, present when the file was accepted",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.DocumentInfo"
                        }
                    ]
                },
                "error": {
                    "description": "Error key when the file was rejected, e.g. error:validation-failed",
                    "type": "string",
                    "example": "error:validation-failed"
                },
                "filename": {
                    "description": "File name as uploaded",
                    "type": "string",
                    "example": "Hoger algemeen voortgezet onderwijs.pdf"
                },
                "message": {
                    "description": "Human readable explanation when rejected (English)",
                    "type": "string",
                    "example": "the signature of the document could not be verified"
                },
                "validation": {
                    "description": "Verification outcome, present as soon as the signature was checked",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.ValidationInfo"
                        }
                    ]
                }
            }
        },
        "models.HealthResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "description": "True if the service is healthy",
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "models.IdentityMatchInfo": {
            "type": "object",
            "properties": {
                "date_of_birth_match": {
                    "type": "boolean",
                    "example": true
                },
                "given_names_match": {
                    "type": "boolean",
                    "example": true
                },
                "matched": {
                    "type": "boolean",
                    "example": true
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "surname differs"
                    ]
                },
                "source": {
                    "description": "Which credential the identity came from: brp, passport, id_card or driving_licence",
                    "type": "string",
                    "example": "passport"
                },
                "surname_match": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "models.IssuanceResponse": {
            "type": "object",
            "properties": {
                "credentials": {
                    "description": "Number of diploma credentials in the issuance request",
                    "type": "integer",
                    "example": 2
                },
                "identity": {
                    "description": "Outcome of the identity comparison that authorised the issuance",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.IdentityMatchInfo"
                        }
                    ]
                },
                "irma_server_url": {
                    "description": "URL of the IRMA server for credential issuance",
                    "type": "string",
                    "example": "https://irma.example.com"
                },
                "jwt": {
                    "description": "Signed JWT containing the IRMA issuance request, one credential per diploma",
                    "type": "string",
                    "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
            }
        },
        "models.PersonInfo": {
            "type": "object",
            "properties": {
                "date_of_birth": {
                    "description": "Date of birth, YYYY-MM-DD",
                    "type": "string",
                    "example": "1980-02-03"
                },
                "full_name": {
                    "type": "string",
                    "example": "Anna Maria van der Berg"
                }
            }
        },
        "models.SessionPointer": {
            "type": "object",
            "properties": {
                "irmaqr": {
                    "description": "Session type",
                    "type": "string",
                    "example": "disclosing"
                },
                "u": {
                    "description": "Session URL on the IRMA server",
                    "type": "string",
                    "example": "https://irma.example.com/irma/session/abc123"
                }
            }
        },
        "models.SessionRequest": {
            "type": "object",
            "properties": {
                "session_id": {
                    "description": "Session identifier from /diploma/upload",
                    "type": "string",
                    "example": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4"
                }
            }
        },
        "models.UploadResponse": {
            "type": "object",
            "properties": {
                "accepted": {
                    "description": "Number of accepted files (diplomas that will be issued)",
                    "type": "integer",
                    "example": 2
                },
                "files": {
                    "description": "Outcome per uploaded file, in upload order",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.FileResult"
                    }
                },
                "person": {
                    "description": "The holder named on the accepted extracts",
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.PersonInfo"
                        }
                    ]
                },
                "rejected": {
                    "description": "Number of rejected files",
                    "type": "integer",
                    "example": 0
                },
                "session_id": {
                    "description": "Session identifier to use in the follow-up requests (32 hex characters)",
                    "type": "string",
                    "example": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4"
                }
            }
        },
        "models.ValidationInfo": {
            "type": "object",
            "properties": {
                "checks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.CheckInfo"
                    }
                },
                "key": {
                    "description": "\"valid\", or the id of the first failed check",
                    "type": "string",
                    "example": "valid"
                },
                "signer": {
                    "description": "Subject of the signing certificate",
                    "type": "string",
                    "example": "CN=Dienst Uitvoering Onderwijs,O=Dienst Uitvoering Onderwijs (DUO),C=NL"
                },
                "signing_time": {
                    "description": "Time of signing, RFC 3339",
                    "type": "string",
                    "example": "2026-09-03T12:34:56Z"
                },
                "timestamp_trusted": {
                    "description": "True when the signing time comes from a trusted RFC 3161 timestamp",
                    "type": "boolean",
                    "example": true
                },
                "trust_anchor": {
                    "description": "Provenance of the trust anchor the signer chains to",
                    "type": "string",
                    "example": "EU trusted list NL: KPN B.V., service \"KPN BV PKIoverheid Organisatie Services CA - G3\" (CA/QC)"
                },
                "valid": {
                    "description": "True when every check passed: the PDF is authentic and unaltered",
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}